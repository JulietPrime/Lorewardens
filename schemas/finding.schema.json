{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lorewardens.local/schemas/finding.schema.json",
  "title": "Lorewardens Finding",
  "description": "A non-destructive continuity finding. Findings never modify the manuscript; suggestions are advisory only.",
  "type": "object",
  "required": [
    "id",
    "agent",
    "category",
    "type",
    "severity",
    "confidence",
    "minStrictness",
    "message",
    "quote",
    "location",
    "canonRefs",
    "suggestion",
    "createdAt"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^fnd_[0-9a-fA-F-]{36}$",
      "description": "Stable finding identifier; writers dismiss by this id."
    },
    "agent": {
      "type": "string",
      "enum": [
        "canon-lore",
        "character-consistency",
        "timeline",
        "grammar-mechanics",
        "vocabulary-repetition",
        "style-voice",
        "character-voice",
        "period-dialect",
        "plot-thread",
        "pacing-tension",
        "pov-consistency",
        "show-vs-tell",
        "sensitivity-representation",
        "theme-motif"
      ],
      "description": "The agent that produced the finding."
    },
    "category": {
      "type": "string",
      "enum": ["canon", "character", "timeline", "language", "prose", "narrative", "optional"]
    },
    "type": {
      "type": "string",
      "description": "Machine-readable finding type, e.g. canon-contradiction, knowledge-violation, impossible-time-jump. Exceptions can target this type."
    },
    "severity": {
      "type": "string",
      "enum": ["info", "minor", "major", "critical"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Agent confidence that this is a real problem."
    },
    "minStrictness": {
      "type": "string",
      "enum": ["gentle", "standard", "strict"],
      "description": "Lowest project strictness level at which this finding surfaces."
    },
    "message": {
      "type": "string",
      "description": "Human-readable explanation of the problem."
    },
    "quote": {
      "type": "string",
      "description": "Exact excerpt from the manuscript the finding is about."
    },
    "location": {
      "type": "object",
      "required": ["file", "startOffset", "endOffset"],
      "additionalProperties": false,
      "properties": {
        "file": { "type": "string" },
        "startOffset": { "type": "integer", "minimum": 0 },
        "endOffset": { "type": "integer", "minimum": 0 },
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 }
      }
    },
    "canonRefs": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Ids of canon entries, characters, or timeline events involved."
    },
    "suggestion": {
      "type": ["string", "null"],
      "description": "Advisory suggested resolution. Never applied automatically; the writer decides."
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
