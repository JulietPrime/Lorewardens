{
  "name": "@lorewardens/mcp-server",
  "version": "0.1.0",
  "description": "Local MCP server exposing Lorewardens agents as tools",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "lorewardens-mcp": "dist/src/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "test": "node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@lorewardens/core": "0.1.0",
    "@lorewardens/agents": "0.1.0",
    "@modelcontextprotocol/sdk": "^1.13.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "@types/node": "^20.14.10"
  }
}
